#!/usr/bin/env bash
# Thin wrapper for stack.py. Needs Python >= 3.11 (tomllib) and psycopg 3.
# With uv: a cached throwaway env with psycopg[binary], independent of the target repo's venv.
# Without uv: plain python3; then psycopg must be importable (pip install 'psycopg[binary]').
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export STACK_PROG="${STACK_PROG:-$0}"
if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --no-project --python '>=3.11' --with 'psycopg[binary]>=3.1' \
    python "$here/stack.py" "$@"
fi
exec python3 "$here/stack.py" "$@"
